          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', created_at) AS time, sum(sum(amount) FILTER (WHERE shield_action = 'hold' AND is_fraud)) OVER (ORDER BY date_trunc('day', created_at)) AS \"Yuma Shield\", sum(sum(amount) FILTER (WHERE baseline_action = 'alert' AND is_fraud)) OVER (ORDER BY date_trunc('day', created_at)) AS \"Current engine\" FROM v_comparison WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
