    {
      "id": 13,
      "type": "timeseries",
      "title": "Fraud amount flagged, cumulative (COP)",
      "description": "Yuma Shield holds the transaction before the money leaves (protected). The current engine alerts after the money has left.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
