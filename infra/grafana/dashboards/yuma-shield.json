          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS p95 FROM decisions WHERE source = 'live' AND $__timeFilter(created_at)",
